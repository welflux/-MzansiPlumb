# VPS example only. Verify paths, service account, Node 24 and storage on the selected Hostinger VPS.
[Unit]
Description=MzansiPlumb web and durable worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=mzansiplumb
Group=mzansiplumb
WorkingDirectory=/opt/mzansiplumb/current
EnvironmentFile=/etc/mzansiplumb.env
ExecStart=/usr/bin/node --use-env-proxy server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mzansiplumb
[Install]
WantedBy=multi-user.target

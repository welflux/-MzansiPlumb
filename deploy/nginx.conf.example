# VPS example only: replace DOMAIN and CERT paths after domain/TLS verification.
limit_req_zone $binary_remote_addr zone=mp_auth:10m rate=2r/s;
server {
 listen 80;
 server_name DOMAIN;
 return 301 https://$host$request_uri;
}
server {
 listen 443 ssl;
 server_name DOMAIN;
 ssl_certificate CERT_FULLCHAIN;
 ssl_certificate_key CERT_PRIVATE_KEY;
 client_max_body_size 9m;
 # Never log private approval/reset links, recipient details or request bodies.
 access_log off;
 location ~ ^/api/auth/(register|login|forgot-password|reset-password|verification-request|verify-email)$ {
  limit_req zone=mp_auth burst=10 nodelay;
  proxy_pass http://127.0.0.1:3001;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
 }
 location / {
  proxy_pass http://127.0.0.1:3001;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
 }
}

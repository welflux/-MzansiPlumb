# Node 24.x. Local development; never put secrets in VITE_* variables.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=var/mzansiplumb.sqlite
# Production: NODE_ENV=production and APP_ORIGIN=https://your-confirmed-domain
# Billing is implemented behind activation gates. Keep BOTH false until explicit approval.
# For encrypted backup/restore only: base64 encoded, randomly generated 32-byte key.
# Store the key in a secret manager; keep it separate from backup files.
# BACKUP_ENCRYPTION_KEY=

# Embedded durable automation runs every 30 seconds. Disable only when a separate
# supervised worker or scheduler runs against the same private DATABASE_PATH.
AUTOMATION_ENABLED=true
# Optional internal reminder email: disabled per company until explicitly enabled.
# Configure securely; verify sender domain and signed webhook before live use.
# RESEND_API_KEY=
# NOTIFICATION_FROM=
# RESEND_WEBHOOK_SECRET=

BILLING_ENABLED=false
BILLING_ACTIVATION_APPROVED=false
BILLING_ENV=sandbox
# Merchant eligibility, currency, recurring/card terms and webhook review evidence reference.
# BILLING_MERCHANT_REVIEW_REFERENCE=
# New random base64 32-byte key. Retain securely with disaster-recovery secrets.
# BILLING_TOKEN_KEY=
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# Recovery/verification delivery is separate from optional operations reminders.
# Enable only after a verified real Resend sender and signed callback round trip.
AUTH_EMAIL_ENABLED=false
REQUIRE_VERIFIED_EMAIL=false
# Production must set REQUIRE_VERIFIED_EMAIL=true (preflight enforces this).
# AUTH_LINK_KEY=  # independent random base64 32-byte key for queued private links
# Optional PDF attachments fail closed unless a maintained ClamAV scanner is set.
# CLAMSCAN_PATH=/usr/bin/clamscan
# Configure exact trusted reverse-proxy CIDRs only after target topology review.
# TRUST_PROXY_CIDRS=loopback

{
  "name": "mzansiplumb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "check:assets": "node scripts/check-assets.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --use-env-proxy --env-file-if-exists=.env --watch server/index.mjs",
    "start": "NODE_ENV=production node --use-env-proxy --env-file-if-exists=.env server/index.mjs",
    "test:api": "node --test tests/api.test.mjs tests/advanced.test.mjs tests/organization.test.mjs tests/security.test.mjs",
    "dev:all": "concurrently --kill-others-on-fail -n api,web \"npm run dev:api\" \"npm run dev\"",
    "worker": "node --use-env-proxy --env-file-if-exists=.env server/worker.mjs",
    "worker:once": "node --use-env-proxy --env-file-if-exists=.env server/worker.mjs --once",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
